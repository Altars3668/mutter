+/* 迟到的 tile 更新距被错过的那次 vblank 起点至少还剩这么久，才立即补交。
+ * 一次翻帧的显示管线编程实测远低于 100 µs。 */
+#define TILE_LATE_UPDATE_MIN_LEAD_US 400
+
+static MetaKmsCrtc *
+find_active_tile_crtc (MetaKmsImplDevice           *impl_device,
+                       const MetaKmsConnectorState *connector_state)
+{
+  MetaKmsImplDevicePrivate *priv =
+    meta_kms_impl_device_get_instance_private (impl_device);
+  const MetaTileInfo *tile_info = &connector_state->tile_info;
+  GList *l;
+
+  if (!connector_state->current_crtc_id ||
+      !tile_info->group_id ||
+      tile_info->max_h_tiles * tile_info->max_v_tiles <= 1)
+    return NULL;
+
+  for (l = priv->crtcs; l; l = l->next)
+    {
+      MetaKmsCrtc *crtc = l->data;
+      const MetaKmsCrtcState *state;
+
+      if (meta_kms_crtc_get_id (crtc) != connector_state->current_crtc_id)
+        continue;
+
+      state = meta_kms_crtc_get_current_state (crtc);
+      if (state->is_active && state->is_drm_mode_valid &&
+          !state->vrr.enabled &&
+          state->drm_mode.hdisplay == tile_info->tile_w &&
+          state->drm_mode.vdisplay == tile_info->tile_h)
+        return crtc;
+
+      return NULL;
+    }
+
+  return NULL;
+}
+
+static gboolean
+tile_sibling_has_pending_primary_flip (MetaKmsImplDevice *impl_device,
+                                       MetaKmsCrtc       *crtc)
+{
+  MetaKmsImplDevicePrivate *priv =
+    meta_kms_impl_device_get_instance_private (impl_device);
+  uint32_t group_id = 0;
+  GList *l;
+
+  for (l = priv->connectors; l; l = l->next)
+    {
+      const MetaKmsConnectorState *state =
+        meta_kms_connector_get_current_state (l->data);
+
+      if (state && find_active_tile_crtc (impl_device, state) == crtc)
+        {
+          group_id = state->tile_info.group_id;
+          break;
+        }
+    }
+
+  if (!group_id)
+    return FALSE;
+
+  for (l = priv->connectors; l; l = l->next)
+    {
+      const MetaKmsConnectorState *state =
+        meta_kms_connector_get_current_state (l->data);
+      MetaKmsCrtc *sibling;
+      CrtcFrame *sibling_frame;
+
+      if (!state || state->tile_info.group_id != group_id)
+        continue;
+
+      sibling = find_active_tile_crtc (impl_device, state);
+      if (!sibling || sibling == crtc)
+        continue;
+
+      sibling_frame = get_crtc_frame (impl_device, sibling);
+      if (sibling_frame && sibling_frame->pending_primary_flip)
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+static gboolean
+update_changes_primary_plane (MetaKmsUpdate *update,
+                              MetaKmsCrtc   *crtc)
+{
+  MetaKmsPlaneAssignment *assignment;
+
+  assignment = meta_kms_update_get_primary_plane_assignment (update, crtc);
+  return assignment &&
+         !(assignment->flags & META_KMS_ASSIGN_PLANE_FLAG_FB_UNCHANGED);
+}
+
+/*
+ * 拼接屏的每块 tile 由独立 CRTC 驱动，各有自己的 deadline。某块 tile 的更新在
+ * deadline 之后才就绪、而兄弟 tile 已为同一次 vblank 提交新帧时，若整帧推迟，
+ * 两侧就会并排显示前后两帧。只要还来得及在该 vblank 前完成编程，就立即提交。
+ * 兄弟 tile 也没赶上 deadline 时，各块一起推迟，仍保持同步。
+ */
+static gboolean
+should_post_late_tile_update (MetaKmsImplDevice *impl_device,
+                              CrtcFrame         *crtc_frame,
+                              int64_t            next_presentation_us)
+{
+  const MetaKmsCrtcState *crtc_state =
+    meta_kms_crtc_get_current_state (crtc_frame->crtc);
+  MetaKmsUpdate *update = crtc_frame->pending_update;
+  int64_t refresh_interval_us;
+  int64_t missed_vblank_start_us;
+
+  if (!update ||
+      meta_kms_update_get_target_presentation_time (update) ||
+      !update_changes_primary_plane (update, crtc_frame->crtc))
+    return FALSE;
+
+  if (!crtc_state->is_drm_mode_valid || crtc_state->vrr.enabled)
+    return FALSE;
+
+  refresh_interval_us =
+    (int64_t) (0.5 + G_USEC_PER_SEC /
+               meta_calculate_drm_mode_refresh_rate (&crtc_state->drm_mode));
+  missed_vblank_start_us =
+    next_presentation_us - refresh_interval_us -
+    meta_calculate_drm_mode_vblank_duration_us (&crtc_state->drm_mode);
+
+  if (missed_vblank_start_us - g_get_monotonic_time () <
+      TILE_LATE_UPDATE_MIN_LEAD_US)
+    return FALSE;
+
+  return tile_sibling_has_pending_primary_flip (impl_device, crtc_frame->crtc);
+}
+
