+/* 只有原子 KMS 能在一次提交中让多个 CRTC 同时翻帧。 */
+gboolean
+meta_kms_device_uses_atomic_modesetting (MetaKmsDevice *device)
+{
+  return META_IS_KMS_IMPL_DEVICE_ATOMIC (device->impl_device);
+}
+
+/*
+ * 拼接显示器由一个整屏视图驱动多个 tile CRTC。这些 CRTC 的更新锁存到同一个
+ * leader：一次原子提交、同一次 vblank 翻帧，共用 leader 的 deadline 与帧状态。
+ * 主线程在建视图时登记，主线程与 KMS 线程都会查询。
+ */
+void
+meta_kms_device_set_crtc_latch_leader (MetaKmsDevice *device,
+                                       MetaKmsCrtc   *crtc,
+                                       MetaKmsCrtc   *leader)
+{
+  g_mutex_lock (&device->latch_leaders_mutex);
+  if (leader && leader != crtc)
+    g_hash_table_insert (device->latch_leaders, crtc, leader);
+  else
+    g_hash_table_remove (device->latch_leaders, crtc);
+  g_mutex_unlock (&device->latch_leaders_mutex);
+}
+
+void
+meta_kms_device_clear_crtc_latch_leaders (MetaKmsDevice *device)
+{
+  g_mutex_lock (&device->latch_leaders_mutex);
+  g_hash_table_remove_all (device->latch_leaders);
+  g_mutex_unlock (&device->latch_leaders_mutex);
+}
+
+MetaKmsCrtc *
+meta_kms_device_get_crtc_latch_leader (MetaKmsDevice *device,
+                                       MetaKmsCrtc   *crtc)
+{
+  MetaKmsCrtc *leader;
+
+  g_mutex_lock (&device->latch_leaders_mutex);
+  leader = g_hash_table_lookup (device->latch_leaders, crtc);
+  g_mutex_unlock (&device->latch_leaders_mutex);
+
+  return leader ? leader : crtc;
+}
+
