+static void
+add_unique_crtc (GPtrArray   *crtcs,
+                 MetaKmsCrtc *crtc,
+                 MetaKmsCrtc *leader)
+{
+  if (meta_kms_device_get_crtc_latch_leader (meta_kms_crtc_get_device (crtc),
+                                             crtc) != leader)
+    return;
+
+  if (!g_ptr_array_find (crtcs, crtc, NULL))
+    g_ptr_array_add (crtcs, crtc);
+}
+
+/*
+ * 原子提交为其中涉及的每个 CRTC 各发一次翻帧事件。拼接整屏视图的更新锁存到
+ * leader，却可能只涉及某个 tile（例如只有那个 tile 上的光标变了），因此要按
+ * 实际涉及的 CRTC 逐个监听；只等 leader 的事件会让帧状态永远挂起。
+ * 返回登记的监听数。
+ */
+static int
+add_crtc_page_flip_listeners (CrtcFrame     *crtc_frame,
+                              MetaKmsUpdate *update,
+                              GMainContext  *thread_context)
+{
+  g_autoptr (GPtrArray) crtcs = g_ptr_array_new ();
+  MetaKmsCrtc *leader = crtc_frame->crtc;
+  GList *l;
+  unsigned int i;
+
+  for (l = meta_kms_update_get_plane_assignments (update); l; l = l->next)
+    add_unique_crtc (crtcs, ((MetaKmsPlaneAssignment *) l->data)->crtc, leader);
+  for (l = meta_kms_update_get_mode_sets (update); l; l = l->next)
+    add_unique_crtc (crtcs, ((MetaKmsModeSet *) l->data)->crtc, leader);
+  for (l = meta_kms_update_get_crtc_updates (update); l; l = l->next)
+    add_unique_crtc (crtcs, ((MetaKmsCrtcUpdate *) l->data)->crtc, leader);
+  for (l = meta_kms_update_get_crtc_color_updates (update); l; l = l->next)
+    add_unique_crtc (crtcs, ((MetaKmsCrtcColorUpdate *) l->data)->crtc, leader);
+
+  if (crtcs->len == 0)
+    g_ptr_array_add (crtcs, leader);
+
+  for (i = 0; i < crtcs->len; i++)
+    {
+      meta_kms_update_add_page_flip_listener (update,
+                                              g_ptr_array_index (crtcs, i),
+                                              &crtc_page_flip_listener_vtable,
+                                              thread_context,
+                                              crtc_frame, NULL);
+    }
+
+  return crtcs->len;
+}
