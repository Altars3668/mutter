Description: clutter-frame-clock: add public clutter_frame_clock_get_refresh_interval() getter
 .
 Exposes the frame clock refresh interval so the GRD handover passive screen-cast stream can coalesce schedule_update() to one update per refresh interval.
Author: Geoffrey <altarscn2@gmail.com>
Origin: downstream, GRD session-handover patch set
Forwarded: not-needed
Last-Update: 2026-06-04

Index: mutter-50.1/clutter/clutter/clutter-frame-clock.c
===================================================================
--- mutter-50.1.orig/clutter/clutter/clutter-frame-clock.c
+++ mutter-50.1/clutter/clutter/clutter-frame-clock.c
@@ -236,6 +236,12 @@ clutter_frame_clock_get_refresh_rate (Cl
   return frame_clock->refresh_rate;
 }
 
+int64_t
+clutter_frame_clock_get_refresh_interval (ClutterFrameClock *frame_clock)
+{
+  return frame_clock->refresh_interval_us;
+}
+
 static void
 clutter_frame_clock_set_refresh_rate (ClutterFrameClock *frame_clock,
                                       float              refresh_rate)
@@ -1153,6 +1159,16 @@ clutter_frame_clock_schedule_update_now
 {
   int64_t next_update_time_us = -1;
 
+  /* A passive frame clock is driven by an external consumer (e.g. a screen
+   * cast stream) rather than by a physical display, so it must keep producing
+   * frames even while inhibited (e.g. when the session is VT-switched away and
+   * the renderer is paused). Otherwise remote/screen-cast consumers freeze. */
+  if (frame_clock->mode == CLUTTER_FRAME_CLOCK_MODE_PASSIVE)
+    {
+      clutter_frame_clock_driver_schedule_update (frame_clock->driver);
+      return;
+    }
+
   if (frame_clock->inhibit_count > 0)
     {
       frame_clock->pending_reschedule = TRUE;
